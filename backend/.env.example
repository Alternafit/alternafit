# Modelo do arquivo .env — este arquivo VAI para o GitHub, então nunca coloque senhas reais aqui.
# Para rodar o projeto: copie este arquivo, renomeie a cópia para ".env" e preencha os valores.

DB_NAME=alternafit
DB_USER=alternafit_user
DB_PASSWORD=sua_senha_aqui
DB_HOST=localhost
DB_PORT=3306

# Chave secreta do Django. Gere uma com o comando (dentro de backend/):
#   venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# e cole entre aspas simples abaixo.
DJANGO_SECRET_KEY='cole_a_chave_gerada_aqui'

# Modo de desenvolvimento. True no seu computador; no servidor, False (ou apague a linha).
DJANGO_DEBUG=True

# ---------------------------------------------------------------------------
# As variáveis abaixo só são necessárias no servidor (veja backend/DEPLOY.md).
# No seu computador, pode deixá-las comentadas.
# ---------------------------------------------------------------------------
# DJANGO_ALLOWED_HOSTS=seuusuario.pythonanywhere.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://seuusuario.pythonanywhere.com
# DJANGO_CORS_ALLOWED_ORIGINS=https://alternafit.vercel.app
# DJANGO_API_THROTTLE_RATE=120/minute
# DJANGO_SECURE_SSL_REDIRECT=True
